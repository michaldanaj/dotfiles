tags: [ packaging ]
---
# To find packages matching <phrase>:
apt search <phrase>

# To show information on a package:
apt show <package>

# To fetch package list:
apt update

# To download and install updates without installing new package:
apt upgrade

# To download and install the updates AND install new necessary packages:
apt dist-upgrade

# To perform a full system upgrade:
apt update && apt dist-upgrade

# To install package(s):
apt install <package>...

# To uninstall package(s):
apt remove <package>...

# To list installed packages:
apt list --installed

# To list reverse dependencies for installed packages:
apt rdepends --installed <package>

# Symulacja odinstalowania (uwaga na metapakiety, sprawdzić w opisie, po wielkości)
apt remove --simulate <package>

# Lista plików
dpkg -L <package>

# Pakiety oznaczone jako manual install, ale również przez system
apt-mark showmanual
